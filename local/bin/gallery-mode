#!/usr/bin/env bash
# gallery-mode: switch the desktop between the two gallery rooms.
#
#   gallery-mode navy     the dark room, Romantic and dramatic landscapes (default)
#   gallery-mode light    paper walls, Impressionist and plein-air paintings
#   gallery-mode toggle   switch to the other room
#   gallery-mode status   print the current room
#   gallery-mode data     reread the paintings and recut them for the screen
#
# Changes the GTK theme, xfwm4 theme, icons, panel (through the GTK theme),
# notifications, terminal colours (Xfce Terminal and Kitty), wallpapers and
# the caption together.
# Which paintings hang where: ~/.config/gallery/wall.yml

set -euo pipefail

SITE="$HOME/code/asemorales.github.io"
WALL="$HOME/.config/gallery/wall.yml"
PICTURES="$HOME/Pictures/gallery"
DATA_DIR="$HOME/.local/share/gallery"
STATE_DIR="$HOME/.local/state/gallery"
TSV="$DATA_DIR/paintings.tsv"
TERMINALRC="$HOME/.config/xfce4/terminal/terminalrc"
KITTY_DIR="$HOME/.config/kitty"
WORKSPACES=4
DEFAULT_MODE=navy

# Terminal palettes, checked for at least 4.5:1 against their background.
# The chrome has no colour, but the ANSI slots keep muted hues so output stays readable.
LIGHT_TERM=(
  ColorBackground=#F2ECDF
  ColorForeground=#231A15
  ColorCursor=#231A15
  ColorCursorForeground=#F2ECDF
  ColorCursorUseDefault=FALSE
  ColorSelection=#F2ECDF
  ColorSelectionBackground=#231A15
  ColorSelectionUseDefault=FALSE
  ColorBold=#231A15
  ColorBoldUseDefault=TRUE
  TabActivityColor=#231A15
  "ColorPalette=#231A15;#B04A2A;#5B6E3A;#85651B;#2F5470;#7D4B63;#3E6F6A;#DDD4C1;#6E6965;#AA4A2B;#5A6E38;#82641A;#3A6588;#8E5672;#3F716C;#FFFFFF"
)
# gwern.net's dark page (#191612) with warm, creamy light greys for text.
NAVY_TERM=(
  ColorBackground=#191612
  ColorForeground=#EFE6D6
  ColorCursor=#E3D8C4
  ColorCursorForeground=#191612
  ColorCursorUseDefault=FALSE
  ColorSelection=#191612
  ColorSelectionBackground=#E3D8C4
  ColorSelectionUseDefault=FALSE
  ColorBold=#FBF4E8
  ColorBoldUseDefault=FALSE
  TabActivityColor=#FBF4E8
  "ColorPalette=#100D0A;#D0704F;#9DB07A;#D9B46A;#7FA3C2;#B98AA2;#86B5AE;#E3D8C4;#978A79;#E08A6B;#B3C496;#E6C88A;#9DBAD3;#CDA4B8;#A3C9C3;#EFE6D6"
)

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

current_mode() { cat "$STATE_DIR/mode" 2>/dev/null || echo "$DEFAULT_MODE"; }

screen_size() {
  xrandr --current | awk '/ connected primary/ { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { split($i, a, "+"); print a[1]; exit } }'
}

# Read the website's paintings plus wall.yml, cut each painting to fill the
# screen, and write paintings.tsv and one file per room.
build_data() {
  mkdir -p "$DATA_DIR/screen"
  python3 -I - "$SITE/_data/paintings.yml" "$WALL" "$PICTURES" "$DATA_DIR" "$(screen_size)" <<'PY'
import glob, os, subprocess, sys, yaml
site, wall_path, pictures, out, size = sys.argv[1:]
sw, sh = (int(x) for x in (size or "3840x2160").split("x"))
wall = yaml.safe_load(open(wall_path, encoding="utf-8"))
paintings = yaml.safe_load(open(site, encoding="utf-8"))
paintings.update(wall.get("extra") or {})
clean = lambda s: " ".join(str(s).split())

wanted = {k for room in wall["rooms"].values() for k in room}
life = wall.get("life") or {}         # caption overrides; "" shows the label alone
rows = []
for key in sorted(wanted):
    p = paintings[key]
    src = sorted(glob.glob(os.path.join(pictures, p["image"] + ".*")))
    if not src:
        sys.exit(f"no file for {key} in {pictures}; download it from {p['source']}")
    w, h = (int(x) for x in subprocess.check_output(
        ["identify", "-format", "%w %h", src[0] + "[0]"]).split())
    # Scale to cover the screen, then cut the overflow, top share from wall.yml.
    scale = max(sw / w, sh / h)
    cw, ch = round(sw / scale), round(sh / scale)
    top = float(wall.get("crop_top", {}).get(key, 0.5))
    x, y = (w - cw) // 2, round((h - ch) * top)
    dest = os.path.join(out, "screen", f"{key}-{sw}x{sh}.jpg")
    if not os.path.exists(dest) or os.path.getmtime(dest) < max(os.path.getmtime(src[0]), os.path.getmtime(wall_path)):
        subprocess.run(["convert", src[0] + "[0]", "-crop", f"{cw}x{ch}+{x}+{y}", "+repage",
                        "-filter", "Lanczos", "-resize", f"{sw}x{sh}!", "-quality", "92", dest], check=True)
    if scale > 1.4:
        print(f"note: {key} is upscaled {scale:.2f}x to fill the screen", file=sys.stderr)
    label = " · ".join(clean(p[k]) for k in ("artist", "title", "year")).upper()
    rows.append("\t".join([key, dest, clean(p["artist"]), clean(p["title"]),
                           clean(p["year"]), clean(life.get(key, p.get("life", ""))), label]))
open(os.path.join(out, "paintings.tsv"), "w", encoding="utf-8").write("\n".join(rows) + "\n")
for room, keys in wall["rooms"].items():
    open(os.path.join(out, f"room-{room}"), "w").write("\n".join(keys) + "\n")
print(f"{len(rows)} paintings cut for {sw}x{sh} in {out}/screen")
PY
}

set_prop() {  # channel property type value
  xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4" 2>/dev/null \
    || xfconf-query -c "$1" -p "$2" -s "$4"
}

set_rgba() {  # channel property r g b
  xfconf-query -c "$1" -p "$2" -r 2>/dev/null || true
  xfconf-query -c "$1" -p "$2" -n \
    -t double -s "$3" -t double -s "$4" -t double -s "$5" -t double -s 1
}

painting_file() { awk -F'\t' -v k="$1" '$1 == k { print $2 }' "$TSV"; }

set_wallpapers() {  # fill-r fill-g fill-b key...
  local r=$1 g=$2 b=$3; shift 3
  local set=("$@") monitors ws key file base
  mapfile -t monitors < <(xrandr --listmonitors | awk 'NR > 1 { print $NF }')
  set_prop xfce4-desktop /backdrop/single-workspace-mode bool false
  for mon in "${monitors[@]}"; do
    for ((ws = 0; ws < WORKSPACES; ws++)); do
      key=${set[ws % ${#set[@]}]}
      file=$(painting_file "$key")
      [ -n "$file" ] || { echo "missing painting: $key" >&2; continue; }
      base="/backdrop/screen0/monitor$mon/workspace$ws"
      set_prop xfce4-desktop "$base/last-image" string "$file"
      set_prop xfce4-desktop "$base/image-style" int 5       # zoomed: the file is already cut to fit
      set_prop xfce4-desktop "$base/color-style" int 0
      set_prop xfce4-desktop "$base/backdrop-cycle-enable" bool false
      set_rgba xfce4-desktop "$base/rgba1" "$r" "$g" "$b"
    done
  done
}

set_panel_load_colors() {  # r g b, for the system load plugin's bars
  local id prop
  for id in $(xfconf-query -c xfce4-panel -lv | awk '$2 == "systemload" { sub("/plugins/plugin-", "", $1); print $1 }'); do
    for prop in cpu memory swap network; do
      set_rgba xfce4-panel "/plugins/plugin-$id/$prop/color" "$1" "$2" "$3"
    done
  done
}

set_terminal() {
  # One write, so xfce4-terminal reloads once with every colour in place.
  [ -e "$TERMINALRC" ] || return 0
  local target tmp
  target=$(readlink -f "$TERMINALRC")    # terminalrc is a link into ~/code/dotfiles
  tmp=$(mktemp "$target.XXXXXX")
  python3 -I - "$target" "$@" > "$tmp" <<'PY'
import sys
path, pairs = sys.argv[1], dict(kv.split("=", 1) for kv in sys.argv[2:])
lines = open(path, encoding="utf-8").read().splitlines()
seen = set()
for i, line in enumerate(lines):
    key = line.split("=", 1)[0]
    if key in pairs:
        lines[i] = f"{key}={pairs[key]}"
        seen.add(key)
at = lines.index("[Configuration]") + 1 if "[Configuration]" in lines else len(lines)
lines[at:at] = [f"{k}={v}" for k, v in pairs.items() if k not in seen]
print("\n".join(lines))
PY
  chmod --reference="$target" "$tmp"
  mv "$tmp" "$target"
}

set_kitty() {
  # room.conf is a local link, so the repo copy stays the same in both rooms.
  [ -e "$KITTY_DIR/kitty.conf" ] || return 0
  ln -sfn "gallery-$1.conf" "$KITTY_DIR/room.conf"
  pkill -USR1 -x kitty 2>/dev/null || true     # open windows reread their config
}

apply() {
  local mode=$1 theme fill set term load
  if [ "$mode" = navy ]; then
    theme=Gallery-Navy; term=("${NAVY_TERM[@]}")
    fill=(0.098039 0.086275 0.070588)          # #191612
    load=(0.620 0.584 0.541)                   # #9E958A
  else
    theme=Gallery; term=("${LIGHT_TERM[@]}")
    fill=(0.949020 0.925490 0.874510)          # paper #F2ECDF
    load=(0.420 0.396 0.376)                   # ink at 62% on paper
  fi

  if [ ! -s "$TSV" ] || [ "$WALL" -nt "$TSV" ]; then build_data >/dev/null; fi
  mapfile -t set < "$DATA_DIR/room-$mode"

  set_prop xsettings /Net/ThemeName string "$theme"
  set_prop xsettings /Net/IconThemeName string "$theme"
  set_prop xfwm4 /general/theme string "$theme"
  set_prop xfce4-notifyd /theme string "$theme"
  set_prop xfce4-panel /panels/dark-mode bool false
  set_panel_load_colors "${load[@]}"
  set_wallpapers "${fill[@]}" "${set[@]}"
  set_terminal "${term[@]}"
  set_kitty "$mode"

  mkdir -p "$STATE_DIR"
  echo "$mode" > "$STATE_DIR/mode"
  printf '%s\n' "${set[@]}" > "$STATE_DIR/set"

  command -v gallery-caption >/dev/null && gallery-caption restart >/dev/null 2>&1 || true
  echo "Gallery mode: $mode"
}

case "${1:-}" in
  light|navy) apply "$1" ;;
  toggle)     [ "$(current_mode)" = light ] && apply navy || apply light ;;
  status)     current_mode ;;
  data)       build_data ;;
  "")         apply "$(current_mode)" ;;
  -h|--help)  usage ;;
  *)          usage; exit 2 ;;
esac
