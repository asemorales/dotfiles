#!/usr/bin/env bash
# gallery-bar: the eww running head that replaces the Xfce panel.
#
#   gallery-bar start        quit xfce4-panel and open the bar
#   gallery-bar stop         close the bar and bring xfce4-panel back
#   gallery-bar room         recolour the bar for the current gallery-mode room
#   gallery-bar goto N       switch to workspace N (from 0)
#   gallery-bar instruments  open btop in its own Kitty window, or close it
#
# eww calls these itself:
#   workspaces, volume           print a new line whenever the value changes
#   network                      print the current connection once
#   volume-up, volume-down       scroll on the volume
#   volume-set N                 drag the volume slider to N%
#
# Layout: ~/.config/eww/eww.yuck. Colours: ~/.config/eww/_navy.scss and _light.scss.

set -euo pipefail

EWW_DIR="$HOME/.config/eww"
STATE_DIR="$HOME/.local/state/gallery"
TSV="$HOME/.local/share/gallery/paintings.tsv"
export PATH="$HOME/.local/bin:$PATH"   # eww runs gallery-bar, gallery-mode and itself by name

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

room() {
  local mode
  mode=$(gallery-mode status 2>/dev/null || echo navy)
  ln -sfn "_$mode.scss" "$EWW_DIR/_room.scss"
  if eww ping >/dev/null 2>&1; then eww reload >/dev/null; fi
}

root_prop() { xprop -root "$1" | awk '{ print $NF }'; }

# The painting that hangs on workspace N, for the plate's tooltip.
painting() {
  local set key
  mapfile -t set < "$STATE_DIR/set" 2>/dev/null || return 0
  [ "${#set[@]}" -gt 0 ] || return 0
  key=${set[$1 % ${#set[@]}]}
  awk -F'\t' -v k="$key" '$1 == k { print $3 ", " $4 ", " $5 }' "$TSV" 2>/dev/null
}

workspaces() {
  xprop -spy -root _NET_CURRENT_DESKTOP _NET_NUMBER_OF_DESKTOPS | while read -r _; do
    local cur n names=() tips=() i
    cur=$(root_prop _NET_CURRENT_DESKTOP)
    n=$(root_prop _NET_NUMBER_OF_DESKTOPS)
    mapfile -t names < <(xprop -root _NET_DESKTOP_NAMES | grep -o '"[^"]*"' | tr -d '"')
    for ((i = 0; i < n; i++)); do
      names[i]=${names[i]:-$((i + 1))}
      tips+=("$(painting "$i")")
    done
    jq -nc --argjson cur "$cur" --argjson n "$n" \
      '$ARGS.positional as $a
        | [range($n) as $i | {n: $i, name: $a[$i], painting: $a[$n + $i], on: ($i == $cur)}]' \
      --args "${names[@]:0:n}" "${tips[@]}"
  done
}

# {"pct":40,"muted":false}, for the slider and its label.
volume_now() {
  local pct muted=false
  pct=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -o '[0-9]*%' | head -1 | tr -d %)
  if pactl get-sink-mute @DEFAULT_SINK@ | grep -q yes; then muted=true; fi
  echo "{\"pct\":${pct:-0},\"muted\":$muted}"
}

volume() {
  volume_now
  pactl subscribe | grep --line-buffered -e "on sink" -e "on server" | while read -r _; do volume_now; done
}

network() {
  nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null \
    | awk -F: '($1 == "wifi" || $1 == "ethernet") && $2 == "connected" { print tolower($3); found = 1; exit }
               END { if (!found) print "offline" }'
}

# btop, the "instruments" behind cpu and mem, in the room's colours. btop
# rewrites its config on exit, so the config stays local and only the themes
# (config/btop/themes) live in the repo. A second click closes the window.
instruments() {
  local conf="$HOME/.config/btop/btop.conf" mode
  if pkill -f "^kitty --class gallery-instruments" 2>/dev/null; then return 0; fi
  command -v btop >/dev/null || { echo "gallery-bar: btop is not installed" >&2; exit 1; }
  mode=$(gallery-mode status 2>/dev/null || echo navy)
  mkdir -p "${conf%/*}"
  [ -s "$conf" ] || btop --default-config > "$conf"
  sed -i -e "s|^color_theme = .*|color_theme = \"gallery-$mode\"|" \
         -e 's|^theme_background = .*|theme_background = False|' \
         -e 's|^rounded_corners = .*|rounded_corners = True|' \
         -e 's|^graph_symbol = .*|graph_symbol = "braille"|' \
         -e 's|^vim_keys = .*|vim_keys = True|' "$conf"
  (setsid kitty --class gallery-instruments --title Instruments \
     -o remember_window_size=no -o initial_window_width=160c -o initial_window_height=46c \
     btop >/dev/null 2>&1 &)
}

start() {
  command -v eww >/dev/null || { echo "gallery-bar: eww is not installed" >&2; exit 1; }
  room
  # --quit stops the session restarting it. Only send it to a running panel:
  # with none running, xfce4-panel pops up a "No running instance" dialog.
  if pgrep -x xfce4-panel >/dev/null; then xfce4-panel --quit 2>/dev/null || true; fi
  eww daemon 2>/dev/null || true
  eww open bar
}

stop() {
  eww close-all 2>/dev/null || true
  eww kill 2>/dev/null || true
  (setsid xfce4-panel >/dev/null 2>&1 &)
}

case "${1:-}" in
  start)       start ;;
  stop)        stop ;;
  room)        room ;;
  instruments) instruments ;;
  goto)        xdotool set_desktop "${2:?workspace number}" ;;
  workspaces)  workspaces ;;
  volume)      volume ;;
  volume-up)   pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
  volume-down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
  volume-set)  pactl set-sink-volume @DEFAULT_SINK@ "${2%.*}%" ;;
  network)     network ;;
  -h|--help)   usage ;;
  *)           usage; exit 2 ;;
esac
