# Xsession does not read ~/.profile.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH"; export PATH ;;
esac

# xfwm4's compositor tiles the 1920x1080 greeter's root pixmap 2x2 until xfdesktop draws.
case $(cat "$HOME/.local/state/bierstadt/mode" 2>/dev/null) in
  light) bierstadt_page='#F2ECDF' ;;
  *)     bierstadt_page='#191612' ;;
esac
"$HOME/.local/bin/bierstadt-root" "$bierstadt_page" 2>/dev/null \
  || xsetroot -solid "$bierstadt_page" 2>/dev/null || true
unset bierstadt_page
